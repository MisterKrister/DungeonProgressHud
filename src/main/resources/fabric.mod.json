{
  "schemaVersion": 1,
  "id": "dungeonprogresshud",
  "version": "${version}",
  "name": "DungeonProgressHud",
  "description": "Catacombs progress and runs-left HUD for SkyBlock.",
  "authors": ["krister"],
  "license": "MIT",
  "icon": "assets/dungeonprogresshud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "dev.krister.dungeonprogresshud.DungeonProgressHudAddon",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "dungeonprogresshud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": ">=0.155.2+26.1.2",
    "fabric-language-kotlin": ">=1.13.13+kotlin.2.4.10",
    "noammaddons": "1.2.7",
    "skyblock-api": ">=4.2.19 <5.0.0"
  },
  "suggests": {
    "skyblockpv": ">=1.8.4",
    "skyblocker": "*"
  }
}
