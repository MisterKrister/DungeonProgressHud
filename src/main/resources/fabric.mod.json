{
  "schemaVersion": 1,
  "id": "dungeonprogresshud",
  "version": "${version}",
  "name": "DungeonProgressHud",
  "description": "Catacombs progress and runs-left HUD for SkyBlock.",
  "authors": ["krister"],
  "license": "MIT",
  "icon": "assets/dungeonprogresshud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "value": "dev.krister.dungeonprogresshud.DungeonProgressHudAddon",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "dungeonprogresshud.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "devonian": ">=1.25.9",
    "skyblock-api": ">=4.2.8"
  },
  "suggests": {
    "skyblockpv": ">=1.8.4",
    "skyblocker": "*"
  }
}
